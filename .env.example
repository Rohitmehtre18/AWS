# --- LLM: LLM_PROVIDER = auto | bedrock | anthropic | openai (none configured => offline mode) ---
LLM_PROVIDER=auto
# Amazon Bedrock (uses standard AWS credentials: env vars, ~/.aws/credentials, or an IAM role)
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
AWS_REGION=us-east-1
# Alternative providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=claude-sonnet-5-5        # or e.g. gpt-4o-mini when using OpenAI

# --- RAG ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5   # bge-base-en-v1.5 / bge-large-en-v1.5 for better quality
CHROMA_DIR=./chroma_db
SEED_DOCS_DIR=./data/sample_docs
TOP_K=4

# --- API ---
CORS_ORIGINS=*                      # comma-separated list in production
MAX_UPLOAD_MB=2
